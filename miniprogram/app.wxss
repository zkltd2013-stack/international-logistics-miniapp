/**app.wxss**/
.container {
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: space-between;
  padding: 200rpx 20rpx;
  box-sizing: border-box;
}

page {
  background-color: #f5f5f5;
  color: #333;
}

/* 通用样式 */
.page-wrapper {
  width: 100%;
  min-height: 100vh;
  background-color: #f5f5f5;
}

.section {
  margin: 20rpx;
  padding: 20rpx;
  background-color: #fff;
  border-radius: 8rpx;
  box-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.1);
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.subtitle {
  font-size: 28rpx;
  font-weight: 600;
  color: #555;
  margin-bottom: 16rpx;
}

.text {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
}

/* 按钮样式 */
.btn {
  width: 100%;
  padding: 16rpx 20rpx;
  border-radius: 8rpx;
  font-size: 28rpx;
  text-align: center;
  transition: all 0.3s ease;
  border: none;
  background-color: #FF6B35;
  color: #fff;
  margin: 10rpx 0;
}

.btn:active {
  opacity: 0.8;
  transform: scale(0.98);
}

.btn-secondary {
  background-color: #e0e0e0;
  color: #333;
}

.btn-secondary:active {
  background-color: #d0d0d0;
}

/* 输入框样式 */
.input-group {
  margin-bottom: 20rpx;
}

.input-label {
  display: block;
  font-size: 26rpx;
  color: #555;
  margin-bottom: 8rpx;
  font-weight: 500;
}

.input-field {
  width: 100%;
  padding: 12rpx 16rpx;
  border: 1rpx solid #ddd;
  border-radius: 6rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.input-field:focus {
  border-color: #FF6B35;
  outline: none;
}

/* 卡片样式 */
.card {
  background-color: #fff;
  border-radius: 8rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.1);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.card-content {
  padding-top: 16rpx;
}

/* Flex布局 */
.flex {
  display: flex;
}

.flex-center {
  display: flex;
  justify-content: center;
  align-items: center;
}

.flex-between {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.flex-column {
  display: flex;
  flex-direction: column;
}

/* 间距 */
.mt-10 { margin-top: 10rpx; }
.mt-20 { margin-top: 20rpx; }
.mb-10 { margin-bottom: 10rpx; }
.mb-20 { margin-bottom: 20rpx; }
.ml-10 { margin-left: 10rpx; }
.mr-10 { margin-right: 10rpx; }
.p-20 { padding: 20rpx; }

/* 文本对齐 */
.text-center {
  text-align: center;
}

.text-left {
  text-align: left;
}

.text-right {
  text-align: right;
}

/* 颜色 */
.text-primary {
  color: #FF6B35;
}

.text-secondary {
  color: #999;
}

.text-success {
  color: #4CAF50;
}

.text-danger {
  color: #f44336;
}

.text-warning {
  color: #FF9800;
}
